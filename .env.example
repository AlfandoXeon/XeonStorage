APP_NAME=XeonStorage
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEFAULT_LANGUAGE=en
MAX_UPLOAD_SIZE_MB=1500
CACHE_MAX_SIZE_MB=500
CACHE_TTL_HOURS=24
SESSION_SECRET=YOUR_RANDOM_SECRET_KEY_HERE

# Database Configuration (SQLite / Turso LibSQL)
DATABASE_URL=sqlite:///./data/xeonstorage.db
DATABASE_AUTH_TOKEN=

# Storage Provider Configuration (telegram / local)
STORAGE_PROVIDER=telegram
LOCAL_STORAGE_PATH=./data/files

# Telegram Hybrid Storage Configuration (Bot API + MTProto for up to 1.5 GB)
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHANNEL_OR_CHAT_ID
TELEGRAM_CHANNEL_ID=YOUR_TELEGRAM_CHANNEL_OR_CHAT_ID
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_STORAGE_ENABLED=true
TELEGRAM_SESSION_STRING=YOUR_MTPROTO_STRING_SESSION

